# ===========================================================================
# Copy to .env and edit.  NEVER commit .env - it is in .gitignore.
#
#   cp .env.example .env
#   nano .env
#   chmod 600 .env
#
# ---------------------------------------------------------------------------
# COMMENTS GO ON THEIR OWN LINE.  Never write:
#
#     MAX_LEVERAGE=3    # some note
#
# The bot's own parser strips that, but systemd's EnvironmentFile= does not -
# it hands the whole string "3    # some note" to the process and the bot
# refuses to start with "expected a number".  Keep every comment on its own
# line and the file works everywhere.
#
# (The bundled systemd unit does not use EnvironmentFile at all - the bot reads
# this file itself.  See the README, section 9.)
# ---------------------------------------------------------------------------
# ===========================================================================

# ---------------------------------------------------------------------------
# TRADING MODE  --  the single most important setting
#
#   paper     simulated fills, no real orders          <-- default, start here
#   backtest  historical replay only (scripts/backtest.py)
#   live      REAL ORDERS WITH REAL MONEY
#
# If this is missing or empty the bot defaults to PAPER. It never enters LIVE
# silently: live mode additionally requires every value in the LIVE section
# below plus passing pre-flight checks at startup.
# ---------------------------------------------------------------------------
TRADING_MODE=paper

# Where market data comes from.
#   mexc       real MEXC market data (public endpoints need no credentials)
#   synthetic  deterministic offline simulator, for demos and testing
DATA_SOURCE=mexc

INSTANCE_NAME=mexc-bot
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# MEXC API CREDENTIALS
#
# Create at:  MEXC -> Account -> API Management
# Required permission:  Futures  (read + trade)
# DO NOT enable withdrawal permission. Restrict to your VPS IP address.
#
# Public market data works without these; they are needed for account access
# and for live trading.
# ---------------------------------------------------------------------------
MEXC_ACCESS_KEY=
MEXC_SECRET_KEY=

MEXC_BASE_URL=https://contract.mexc.com
MEXC_WS_URL=wss://contract.mexc.com/edge
MEXC_RECV_WINDOW=30

# ---------------------------------------------------------------------------
# TELEGRAM
#
#   1. Talk to @BotFather -> /newbot -> copy the token
#   2. Send your new bot any message
#   3. Get your chat id and user id from @userinfobot, or:
#        curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
#
# TELEGRAM_ALLOWED_USER_IDS is the control allowlist. Only these Telegram user
# ids may issue commands. It is REQUIRED for live mode.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# Replace the control panel in place instead of stacking a new copy under it
# every time you press REFRESH or MENU. Trade alerts and reports are never
# replaced - those are the record, and must survive a panel refresh.
TELEGRAM_SINGLE_PANEL=true

# ---------------------------------------------------------------------------
# DATABASE
#   sqlite:///data/trading_bot.db          (default, zero setup)
#   postgresql://user:pass@host:5432/bot   (requires the psycopg extra)
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/trading_bot.db

# ---------------------------------------------------------------------------
# RISK  --  these defaults are deliberately conservative.
# Raising them raises your probability of ruin. The bot refuses obviously
# dangerous values (e.g. MAX_LEVERAGE above 20) and will not start.
# ---------------------------------------------------------------------------
# 0.5% of equity risked per trade
DEFAULT_RISK_PER_TRADE=0.005
# 2% - halts new entries for the UTC day
MAX_DAILY_LOSS=0.02
# 2% correlation-adjusted total open risk
MAX_PORTFOLIO_RISK=0.02
# 1.2% within one correlated cluster
MAX_CORRELATED_EXPOSURE=0.012
# 10% peak-to-trough halts trading
MAX_DRAWDOWN_STOP=0.10
MAX_CONSECUTIVE_LOSSES=4

MAX_OPEN_POSITIONS=3
MAX_LEVERAGE=3
MIN_LEVERAGE=1

# ---------------------------------------------------------------------------
# SIGNAL GATES  --  every one of these must pass before a trade is taken
# ---------------------------------------------------------------------------
MIN_CONFIDENCE=0.70
# Break-even win rate 37% (2.0 needs 33%). The regime multiplier still raises
# this: 2.0x in a range means 3.4 there.
MIN_RR=1.7
# The timeframe entries are timed on. Higher timeframes still supply context
# and bias; this is where the entry, stop and target geometry is measured.
# Only 15m or 5m are supported - a 4h "entry" is a context read, not an entry.
EXECUTION_TIMEFRAME=15m
# below this the stop sits inside the noise
MIN_ATR_PCT=0.0015
# above this stops are unreliable
MAX_ATR_PCT=0.15
MAX_SPREAD_PCT=0.0008
MIN_24H_QUOTE_VOLUME=5000000

# ---------------------------------------------------------------------------
# SCANNER
#
# Three stages, each narrowing the field:
#
#   1. pre-screen   every contract, from one bulk ticker call (free)
#                   -> keeps MAX_SYMBOLS_TO_SCAN
#   2. screen       one timeframe per symbol: trend, momentum, volatility,
#                   expansion (1 fetch each)
#                   -> keeps SCREEN_COUNT, ranks them
#   3. deep         six timeframes + structure + ICT + RTM + order book
#                   -> analyses the best DEEP_ANALYSIS_COUNT
#
# Stage 2 is what lets the bot look at many symbols cheaply. A ticker tells you
# a coin is liquid; it does not tell you anything is happening on the chart.
# Raise SCREEN_COUNT to widen the search, DEEP_ANALYSIS_COUNT to deepen it.
#
# Candle data is cached until the next bar closes, so after the first cycle
# most of this costs nothing. Expect the FIRST cycle after a restart to take
# a few minutes when these numbers are large - that is warmup, not a hang.
# ---------------------------------------------------------------------------
MAX_SYMBOLS_TO_SCAN=100
SCANNER_INTERVAL_SECONDS=60
# 0 disables stage 2
SCREEN_COUNT=60
SCREEN_TIMEFRAME=1h
DEEP_ANALYSIS_COUNT=15
QUOTE_CURRENCY=USDT
SYMBOL_BLACKLIST=

# Parallelism. Higher = faster cycles, but MEXC rate-limits at ~15 requests/s
# and a ban is worse than a slow scan. Above 64 is refused outright.
SCREEN_CONCURRENCY=12
SCANNER_CONCURRENCY=6
MARKET_DATA_CONCURRENCY=8

# Which instrument classes may enter the universe. CRYPTO is always allowed.
#
# MEXC lists tokenised equities (SNDKSTOCKUSDT, MUSTOCKUSDT), leveraged equity
# ETFs (SOXLUSDT), commodities (XAUUSDT) and FX. They report a 24h volume so
# they pass a naive liquidity filter, but they frequently have no quotable
# order book, they gap between sessions instead of trading continuously, and
# the whole analytical stack assumes a 24/7 order-driven market. Each one that
# reaches deep analysis costs a slot a tradable crypto symbol could have used.
#
# Add TOKENISED_EQUITY, INDEX, COMMODITY, FX, STABLECOIN to admit them, or ALL
# to disable the filter entirely.
ALLOWED_INSTRUMENT_CLASSES=CRYPTO

# When a symbol's order book cannot be fetched or comes back empty, bench it
# for this many minutes rather than paying for the same rejection every cycle.
ORDER_BOOK_BENCH_MINUTES=30

# ---------------------------------------------------------------------------
# EXECUTION COSTS  --  used by the paper engine and the backtester
# ---------------------------------------------------------------------------
TAKER_FEE=0.0006
MAKER_FEE=0.0002
SLIPPAGE_PCT=0.0005
LATENCY_MS=250
FUNDING_INTERVAL_HOURS=8

# ---------------------------------------------------------------------------
# POSITION MANAGEMENT
# ---------------------------------------------------------------------------
TP1_R=1.0
TP2_R=2.0
TP3_R=3.5
# close 40% at TP1
TP1_CLOSE_PCT=0.4
# then 35% at TP2; the rest runs
TP2_CLOSE_PCT=0.35
BREAKEVEN_AT_R=1.0
BREAKEVEN_OFFSET_R=0.1
TRAILING_ACTIVATE_R=1.8
TRAILING_ATR_MULT=1.6
STOP_ATR_MULT=1.5
MAX_STOP_PCT=0.08
MIN_STOP_PCT=0.0015

# ---------------------------------------------------------------------------
# MACHINE LEARNING
# The bot runs on rules alone when no model is trained. The model can only
# adjust confidence; it can never create a trade on its own.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# FUNDAMENTALS
#
# Macro context - BTC trend, funding, open interest - always comes from the
# exchange and needs no configuration.
#
# NEWS_FEED_URL adds a headline feed on top. It must return JSON: a list of
# objects, or an object with a data/results/articles key, each carrying a title
# and a timestamp. Left empty, the news read stays UNKNOWN rather than
# inventing a sentiment - and UNKNOWN is never converted into bullish or
# bearish anywhere in the system.
#
# Populate data/economic_calendar.json for blackout windows around CPI, FOMC,
# NFP and similar:
#   {"events": [{"name": "US CPI", "ts": 1735689600, "impact": "high"}]}
#
# News can veto or shrink a trade. It can never create one.
# ---------------------------------------------------------------------------
NEWS_FEED_URL=
NEWS_MAX_AGE_HOURS=6
NEWS_BLACKOUT_BEFORE_MINUTES=30
NEWS_BLACKOUT_AFTER_MINUTES=15

ML_ENABLED=true
ML_MODEL_NAME=direction_v1
# capped at 0.5 - rules always keep the majority
ML_WEIGHT=0.35
ML_MIN_TRAINING_ROWS=400

# ---------------------------------------------------------------------------
# AUTONOMOUS RETRAINING
#
# The bot retrains itself on a schedule and grades each candidate against its
# OWN realised trades - the journal stores the feature vector as it was at
# decision time plus what actually happened, so the bot's history is already a
# labelled dataset drawn from the distribution it really faces.
#
# Promotion is deliberately hard. Retraining on recent data and deploying
# whatever comes out is how a system chases noise into a drawdown. A challenger
# must pass the same acceptance test as a manual run, survive the overfitting
# detector, AND beat the champion on real trades by the margin below. A tie
# leaves the champion in place: the incumbent has already been tested with real
# money, so the burden of proof sits with the challenger.
#
# This only swaps which model informs CONFIDENCE. Its influence stays capped at
# ML_WEIGHT and it can never create a trade, raise a size, or touch a risk
# limit. Automating the retraining does not widen what the model may do.
#
# Leave this off until you have run paper mode long enough to have a real
# trading history for it to learn from.
# ---------------------------------------------------------------------------
AUTO_TRAIN_ENABLED=false
AUTO_TRAIN_INTERVAL_HOURS=24
# resolved trades needed before retraining again
AUTO_TRAIN_MIN_NEW_TRADES=20
# real trades needed before their verdict is trusted
AUTO_TRAIN_MIN_LIVE_SAMPLES=40
# lift the challenger must add on real trades
AUTO_TRAIN_PROMOTION_MARGIN=0.10
AUTO_TRAIN_SYMBOLS=30
AUTO_TRAIN_BARS=6000
AUTO_TRAIN_TIMEFRAME=15m
AUTO_TRAIN_HORIZON=24

# ---------------------------------------------------------------------------
# INTELLIGENCE LAYER
#
# A second opinion that sits on top of the signal engine: an ensemble of
# independent models, order-flow and liquidity reads, data / model / execution
# risk scores, a no-trade model, a trade-quality score and an expected-value
# check.
#
# It has veto power and it can shrink a position. It can NEVER create a trade
# the signal engine rejected, and it can NEVER raise size or relax a risk
# limit. Turning it off makes the bot less selective, not more capable.
#
# Every threshold below only ever makes the bot fussier as you raise it.
# ---------------------------------------------------------------------------
INTELLIGENCE_ENABLED=true
# composite score out of 100
MIN_TRADE_QUALITY=55
# minimum shrunk expected value, in R
MIN_EXPECTED_VALUE_R=0.05
# share of the directional vote that must agree
MIN_MODEL_AGREEMENT=0.60
# lower = refuses more trades
NO_TRADE_THRESHOLD=0.5
# block entries above this anomaly severity
MAX_ANOMALY_SEVERITY=0.65
# estimated slippage above this is fatal
MAX_SLIPPAGE_PCT=0.0035
# the ensemble must back the chosen direction
REQUIRE_ENSEMBLE_AGREEMENT=true

# ---------------------------------------------------------------------------
# PAPER TRADING
# ---------------------------------------------------------------------------
PAPER_STARTING_EQUITY=1000

# ---------------------------------------------------------------------------
# DASHBOARD   ->   http://<server>:8000
# Set DASHBOARD_TOKEN to require a token for pause/resume/emergency.
# Read-only endpoints stay open. Do NOT expose port 8000 to the internet
# without a reverse proxy and TLS.
# ---------------------------------------------------------------------------
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_TOKEN=

# ---------------------------------------------------------------------------
# SAFETY
#
# KILL_SWITCH_FILE: create this file and the bot stops opening new trades
# immediately, no restart needed:
#     docker compose exec bot touch /app/data/KILL_SWITCH
# Delete it to resume.
# ---------------------------------------------------------------------------
KILL_SWITCH_FILE=data/KILL_SWITCH

# ---------------------------------------------------------------------------
# LIVE MODE  --  required only when TRADING_MODE=live
#
# Set this EXACTLY to: I UNDERSTAND THE RISK
# It exists so that switching to live is a deliberate act, not a typo.
# ---------------------------------------------------------------------------
LIVE_CONFIRM_PHRASE=
